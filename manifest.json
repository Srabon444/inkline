{
  "manifest_version": 3,
  "name": "Inkline: Styled Email Subjects",
  "short_name": "Inkline",
  "version": "1.0.0",
  "description": "Make email subject lines stand out with bold, italic, underline, strikethrough, bubbles and more. Free, no account.",
  "homepage_url": "https://github.com/Srabon444/inkline",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "styles.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
